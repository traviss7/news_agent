# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Gmail 예시: smtp_host=smtp.gmail.com, port=465, use_ssl=true
# Naver 예시: smtp_host=smtp.naver.com, port=465, use_ssl=true
# Office365 예시: smtp_host=smtp.office365.com, port=587, use_ssl=false (STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_SSL=true          # true = SSL(465), false = STARTTLS(587)

EMAIL_SENDER=your_email@gmail.com
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# ── Schedule ──────────────────────────────────────────────────────────────────
SCHEDULE_HOUR=8            # 실행 시각 (시) — 기본값 오전 8시
SCHEDULE_MINUTE=0          # 실행 시각 (분)
TIMEZONE=Asia/Seoul        # 시간대 (예: America/New_York, Europe/London)

# ── Article filtering ─────────────────────────────────────────────────────────
HOURS_BACK=24              # 최근 몇 시간 이내 기사를 가져올지
MAX_PER_FEED=10            # 피드당 최대 기사 수
MIN_IMPORTANCE=0           # 이 값 이상인 기사만 포함 (0 = 전체 포함)
